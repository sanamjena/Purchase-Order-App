<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <description>Expected delivery must be on or after order date.</description>
    <errorConditionFormula>AND(NOT(ISBLANK(Expected_Delivery_Date__c)), NOT(ISBLANK(Order_Date__c)), Expected_Delivery_Date__c &lt; Order_Date__c)</errorConditionFormula>
    <errorDisplayField>Expected_Delivery_Date__c</errorDisplayField>
    <errorMessage>Expected delivery date cannot be earlier than order date.</errorMessage>
</ValidationRule>
